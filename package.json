    "test:newsletter-r3a1": "node --import tsx --test scripts/prepare-newsletter-supabase-ci.test.ts",
    "test:newsletter-r3b1": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r3b1.test.ts",
    "test:newsletter-r3b2": "node --import tsx --test tests/newsletter/newsletter-r3b2.test.ts",
    "test:newsletter-r3b3": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r3b3.test.ts && node --import tsx --test tests/newsletter/newsletter-r3b3-render.test.tsx",
    "test:newsletter-r3b4": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r3b4.test.ts && node --import tsx --test tests/newsletter/newsletter-r3b4-render.test.tsx",
    "test:newsletter-r4a": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r4a.test.ts && node --import tsx --test tests/newsletter/newsletter-r4a-render.test.tsx",
    "test:newsletter-r4b": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r4b.test.ts && node --import tsx --test tests/newsletter/newsletter-r4b-branding.test.tsx",
    "test:newsletter-r5a": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r5a.test.ts",
    "test:newsletter-r5a1": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r5a1.test.ts",
    "test:newsletter-r5a2": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r5a2.test.ts",
    "test:newsletter-r5a3": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r5a3.test.ts",
    "test:newsletter-r5b": "node --conditions=react-server --import tsx --test tests/newsletter/newsletter-r5b.test.ts",
    "typecheck": "tsc --noEmit",
    "backfill:vehicle-type": "tsx scripts/backfill-event-vehicle-type.ts",
    "replace:events-seed": "tsx scripts/replace-events-seed.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "next": "16.2.4",
    "nodemailer": "^8.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.9.0",
    "server-only": "^0.0.1",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
