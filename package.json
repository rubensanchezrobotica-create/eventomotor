    "import:karting": "node scripts/import-karting-events.mjs --import",
    "import:ferias:dry": "node scripts/import-ferias-events.mjs --dry-run",
    "import:ferias": "node scripts/import-ferias-events.mjs --import",
    "import:trackdays:dry": "node scripts/import-trackdays-events.mjs --dry-run",
    "import:trackdays": "node scripts/import-trackdays-events.mjs --import",
    "import:rutas:dry": "node scripts/import-rutas-events.mjs --dry-run",
    "import:rutas": "node scripts/import-rutas-events.mjs --import",
    "import:concentraciones:dry": "node scripts/import-concentraciones-events.mjs --dry-run",
    "import:concentraciones": "node scripts/import-concentraciones-events.mjs --import",
    "export:events": "tsx scripts/export-current-events.ts",
    "report:events-quality": "tsx scripts/generate-events-quality-report.ts",
    "report:events-corrections": "tsx scripts/generate-events-corrections-proposal.ts",
    "research:export-future-events": "tsx scripts/export-future-events-for-enrichment.ts",
