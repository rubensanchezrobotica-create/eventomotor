# R5A remains disabled unless the exact production canary guard is complete.
NEWSLETTER_PRODUCTION_CANARY_ARMED=
NEWSLETTER_PRODUCTION_CANARY_ORIGIN=
NEWSLETTER_PRODUCTION_CANARY_ALLOWLIST=
# R5B public launch requires the exact armed value and canonical Production origin.
NEWSLETTER_PUBLIC_LAUNCH_ENABLED=
NEWSLETTER_EDITION_01_CAMPAIGN_ARMED=
NEWSLETTER_EDITION_02_CAMPAIGN_ARMED=
NEWSLETTER_PUBLIC_LAUNCH_ORIGIN=
# R4A remains disabled unless mode=test, transport=resend and every value is valid.
NEWSLETTER_RESEND_API_KEY=
NEWSLETTER_RESEND_WEBHOOK_SECRET=
# R5A requires: La Agenda Motor · EventoMotor <agenda@news.eventomotor.com>
NEWSLETTER_RESEND_FROM=
# R5A requires: info@eventomotor.com
NEWSLETTER_RESEND_REPLY_TO=
# Edition 01/02 test sends share this explicit local-only arming gate.
NEWSLETTER_EDITION_TEST_SEND_ARMED=
# Comma-separated exact test addresses only; wildcards and domains are rejected.
NEWSLETTER_TEST_RECIPIENT_ALLOWLIST=
